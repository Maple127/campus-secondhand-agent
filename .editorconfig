root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,html,css,js}]
indent_size = 2

[*.{properties,sql}]
indent_size = 4
trim_trailing_whitespace = false

# PowerShell 在 Windows 上依赖 CRLF
[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab
