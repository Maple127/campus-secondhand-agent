# ============================================================
# Agent 服务配置示例
# 复制为 .env 后填入真实值；.env 已在 .gitignore 中，不会入库
# ============================================================

# ---- LLM（DeepSeek）----
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Java 后端 ----
BACKEND_BASE_URL=http://localhost:8081
# 必须与后端 application.properties 中 app.agent.service-token 一致
# 后端默认值: demo-agent-token-local
AGENT_SERVICE_TOKEN=demo-agent-token-local
# 后端请求是否走系统代理。默认 false。
# Windows 上 Python 会从注册表读到系统代理（如 127.0.0.1:7897），
# 若设为 true 会把 localhost 请求也送去代理，表现为 HTTP 502。
BACKEND_TRUST_ENV=false
# LLM 请求是否走系统代理。默认 true（访问 api.deepseek.com 常需要代理）。
LLM_TRUST_ENV=true

# ---- 服务自身 ----
AGENT_HOST=127.0.0.1
AGENT_PORT=8090
LOG_LEVEL=INFO

# ---- 日志与安全 ----
# 是否在日志中打印工具调用的完整参数（排查用，生产建议 false）
LOG_TOOL_ARGS=true
# 单轮对话最多允许的模型步数，防止工具调用死循环
MAX_AGENT_STEPS=8
